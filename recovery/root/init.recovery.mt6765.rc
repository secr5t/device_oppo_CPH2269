on init
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw

on fs
    install_keyring

service mobicore /vendor/bin/mcDriverDaemon -r /vendor/app/mcRegistry/020b0000000000000000000000000000.drbin -r /vendor/app/mcRegistry/07060000000000000000000000000000.drbin -r /vendor/app/mcRegistry/06090000000000000000000000000000.drbin -r /vendor/app/mcRegistry/070f000000000000000000000000a0a.tlbin
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0-trustonic /system/bin/android.hardware.keymaster@4.0-service.trustonic
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service cryptoeng-1-0 /system/bin/hw/vendor.oplus.hardware.cryptoeng@1.0-service
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service health-hal-2-1 /system/bin/android.hardware.health@2.1-service
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

on property:hwservicemanager.ready=true
    start mobicore
    start keymaster-4-0-trustonic
    start gatekeeper-1-0
    start cryptoeng-1-0
    start health-hal-2-1

on property:ro.crypto.state=encrypted
    start mobicore
    start keymaster-4-0-trustonic
    start gatekeeper-1-0
    start cryptoeng-1-0
